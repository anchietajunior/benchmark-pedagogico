# Raw study records and private judge preparation stay local by default.
/coleta/entrada/*
!/coleta/entrada/.gitkeep
/coleta/comprovantes/*
!/coleta/comprovantes/.gitkeep
/coleta/privado/
/coleta/juizes/
/coleta/consolidado/

# Local OpenRouter credentials, configuration and licensed reference excerpts.
.env
.env.*
!.env.example
/openrouter.config.json
/fontes/openrouter/
/node_modules/
